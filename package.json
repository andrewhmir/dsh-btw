{
  "name": "@andrewhmir/dsh-btw",
  "version": "0.1.2",
  "description": "Ephemeral /btw side questions for the DeepSeek Harness Web GUI.",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["host.js", "src/**/*.mjs", "src/client-entry.js", "client.js",
            "tools/build-client.mjs", "cordis.patch.yml", "locale/*.json",
            "icon.svg", "LICENSE", "README.md", "MOUNT.md"],
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": { "node": ">=22", "dsh": ">=0.2.0-rc.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}
